# =========================================================================
# CONFIGURACIÓN DE ENTORNO - TODO SEVILLA (EJEMPLO)
# Copia este archivo como .env para desarrollo local y personaliza los valores.
# En producción, estas variables se configuran en el Stack de Portainer.
# =========================================================================

# URL de conexión a la base de datos PostgreSQL
# Desarrollo: postgresql://todosevilla_dev:todosevilla_dev_pass@localhost:5432/todosevilla_dev?schema=public
# Producción (Swarm): postgresql://<usuario>:<contraseña>@db:5432/<nombre_db>?schema=public
DATABASE_URL="postgresql://todosevilla_dev:todosevilla_dev_pass@localhost:5432/todosevilla_dev?schema=public"

# Credenciales para el administrador por defecto (se crean en el primer arranque si no existen)
ADMIN_EMAIL="admin@todosevilla.es"
ADMIN_PASSWORD="CambiaEstaContrasenaSegura123!"

# Secreto de firma para las sesiones de administración (JWT / Cookies)
# Genera un string aleatorio largo y seguro, ej: openssl rand -base64 32
JWT_SECRET="un_secreto_super_seguro_y_largo_para_firmar_los_tokens_jwt_12345"

# URL del Webhook de Portainer para la actualización automática sin caídas
# Se obtiene de la sección "Webhooks" del servicio 'app' en el panel de Portainer.
PORTAINER_WEBHOOK_URL="https://192.168.0.60:9443/api/webhooks/xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# SHA del commit de Git actual (Inyectado en producción de forma automática por GitHub Actions)
GIT_COMMIT_SHA="dev-local-sha"

# Token del Túnel de Cloudflare (Generado en el panel de Cloudflare Zero Trust)
CLOUDFLARE_TUNNEL_TOKEN="tu_token_de_cloudflare_tunnel_aqui"

# CN (Common Name) del certificado SSL autofirmado que genera el proxy en el arranque
# (por defecto se usa la IP local del servidor). Evita regenerarlo si no cambias la IP.
PROXY_CERT_CN="192.168.0.60"

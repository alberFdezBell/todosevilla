# ============================================================
# TODO SEVILLA — Variables de Entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env con secretos reales a Git.
# ============================================================

# --- BASE DE DATOS ---
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
POSTGRES_USER=todosevilla
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=todosevilla_db
DATABASE_URL=postgresql://todosevilla:CAMBIA_ESTA_CONTRASENA@localhost:5432/todosevilla_db?schema=public

# --- APLICACIÓN ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SEGURIDAD ADMIN ---
# Genera un secreto aleatorio de 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_32_CARACTERES_MINIMO
# Contraseña inicial del admin (si no existe usuario en BD)
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_ADMIN
